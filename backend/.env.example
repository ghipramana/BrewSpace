# ==============================================================================
# BrewSpace: Konfigurasi Environment Backend (Express.js)
# Salin file ini menjadi .env dan sesuaikan nilainya
# ==============================================================================

# Port server lokal backend
PORT=5000

# Mode environment: development | production
NODE_ENV=development

# Kredensial Supabase (Didapatkan dari Dashboard Supabase: Project Settings -> API)
# URL project Supabase Anda (contoh: https://xyzcompany.supabase.co)
SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Service Role Key (Wajib di backend saja, JANGAN disebarkan ke publik/frontend)
# Digunakan backend untuk verifikasi token, bypass RLS saat agregasi data, dll.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your_service_role_key_here

# Supabase Anon Key (Kunci publik)
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your_anon_public_key_here

# URL frontend yang diizinkan untuk CORS (Cross-Origin Resource Sharing)
CLIENT_URL=http://localhost:5173
